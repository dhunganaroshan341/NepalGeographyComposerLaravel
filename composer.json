{
  "name": "roshan-dhungana/nepal-geography",
  "description": "Reusable Nepal provinces, districts and municipalities dataset for Laravel",
  "type": "library",
  "license": "MIT",

  "keywords": [
    "laravel",
    "nepal",
    "geography",
    "provinces",
    "districts",
    "municipalities",
    "wards"
  ],

  "homepage": "https://github.com/dhunganaroshan341/NepalGeographyComposerLaravel",

  "support": {
    "issues": "https://github.com/dhunganaroshan341/NepalGeographyComposerLaravel/issues",
    "source": "https://github.com/dhunganaroshan341/NepalGeographyComposerLaravel"
  },

  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },

  "autoload": {
    "psr-4": {
      "RoshanDhungana\\NepalGeography\\": "src/",
    "RoshanDhungana\\NepalGeography\\Seeders\\": "database/seeders/"
    }
  },

  "extra": {
    "laravel": {
      "providers": [
        "RoshanDhungana\\NepalGeography\\NepalGeographyServiceProvider"
      ]
    }
  },

  "authors": [
    {
      "name": "Roshan Dhungana",
      "email": "dhunganaroshan341@gmail.com"
    }
  ],

  "minimum-stability": "stable",
  "prefer-stable": true
}